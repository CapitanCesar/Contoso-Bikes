/// Dimensión de productos con clasificación comercial y rol estratégico.
table dim_Producto
	lineageTag: 00390c4e-0594-458c-aa81-6cffd6d70344

	column IdProducto
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0b4ff242-0dda-4d75-a6c6-23d401cd5462
		summarizeBy: sum
		sourceColumn: IdProducto

		annotation SummarizationSetBy = Automatic

	column Producto
		dataType: string
		lineageTag: 14262739-b465-47dd-a87a-80ac252be5da
		summarizeBy: none
		sourceColumn: Producto

		annotation SummarizationSetBy = Automatic

	column Familia
		dataType: string
		isHidden
		lineageTag: 48e5b888-885a-4c30-a470-b9447c84317c
		summarizeBy: none
		sourceColumn: Familia

		annotation SummarizationSetBy = Automatic

	column SubFamilia
		dataType: string
		lineageTag: 5bc59c6e-c2de-4844-b428-1629d71cdd21
		summarizeBy: none
		sourceColumn: SubFamilia

		annotation SummarizationSetBy = Automatic

	column Modelo
		dataType: string
		lineageTag: 4177c827-0ce0-4f28-a502-2e2ebc9f50a4
