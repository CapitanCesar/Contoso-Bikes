				    #"Removed Other Columns1" = Table.SelectColumns(#"Renamed Columns",{"Color", "Familia", "Foto", "IdProducto", "Modelo", "Producto", "SubFamilia"}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Removed Other Columns1",{"IdProducto", "Producto", "Familia", "SubFamilia", "Modelo", "Color", "Foto"})
