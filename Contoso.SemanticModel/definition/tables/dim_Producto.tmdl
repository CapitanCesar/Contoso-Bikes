	column Color
		dataType: string
		lineageTag: 95af19f0-f909-4316-bd7f-d43ace5982b0
		summarizeBy: none
		sourceColumn: Color

		annotation SummarizationSetBy = Automatic

	column Foto
		dataType: string
		lineageTag: a7023daa-0fcb-4659-b0df-427fdbd222a7
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: Foto

		annotation SummarizationSetBy = Automatic

	/// Agrupación comercial estandarizada de las familias de producto.
	column 'Familia Comercial' =
			VAR FamiliaBase = UPPER( TRIM( COALESCE( 'dim_Producto'[Familia], "" ) ) )
			RETURN
			    SWITCH(
			        TRUE(),
			        CONTAINSSTRING( FamiliaBase, "BIKE" ) || CONTAINSSTRING( FamiliaBase, "BICICLETA" ), "Bicicletas",
			        CONTAINSSTRING( FamiliaBase, "COMPONENT" ), "Componentes",
			        CONTAINSSTRING( FamiliaBase, "ACCESS" ), "Accesorios",
			        CONTAINSSTRING( FamiliaBase, "CLOTHING" ) || CONTAINSSTRING( FamiliaBase, "ROPA" ), "Ropa",
			        FamiliaBase = "GENERAL", "General",
			        FamiliaBase = "UNIDAD DE PAR", "Otros",
			        FamiliaBase = "", "Otros",
			        "Otros"
			    )
		dataType: string
		lineageTag: 1e8c23e4-df68-471a-9846-c6f41a063a16

	/// Rol estratégico del producto según la lógica comercial del negocio.
	column 'Rol Estratégico' = IF( 'dim_Producto'[Familia Comercial] = "Bicicletas", "Producto tractor", "Venta complementaria" )
		dataType: string
		lineageTag: 5e444353-16cf-4d5d-958b-72781984aa96

	/// Jerarquía comercial de producto.
	hierarchy 'Jerarquía Producto'
		lineageTag: 6956ef4d-275d-45ed-8674-d2af67d1cf14

		level 'Familia Comercial'
			lineageTag: 59494cb7-38fc-4452-972f-a87335932516
			column: 'Familia Comercial'

		level SubFamilia
			lineageTag: 014e97e4-f0e0-4a59-bf65-a0bb15bad3eb
			column: SubFamilia

		level Producto
			lineageTag: 6fc77d5a-6eed-4658-a197-325bb60230c4
			column: Producto

	partition dProductos = m
		mode: import
		queryGroup: Dimensiones
