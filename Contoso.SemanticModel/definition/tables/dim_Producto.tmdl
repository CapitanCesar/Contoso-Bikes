				    #"Changed Type" = Table.TransformColumnTypes(xerppasm_Productos_Table,{{"xerppasm_color", type text}, {"xerppasm_costeestandar", type number}, {"xerppasm_costeestandar_base", type number}, {"xerppasm_familia", type text}, {"xerppasm_foto", type text}, {"xerppasm_idempresa", Int64.Type}, {"xerppasm_idfamilia", Int64.Type}, {"xerppasm_idmodelo", Int64.Type}, {"xerppasm_idproducto", Int64.Type}, {"xerppasm_idproveedor", type any}, {"xerppasm_idsubfamilia", Int64.Type}, {"xerppasm_modelo", type text}, {"xerppasm_nombreproducto", type text}, {"xerppasm_nombreproveedor", type any}, {"xerppasm_peso", type number}, {"xerppasm_productosid", type text}, {"xerppasm_pulista", type number}, {"xerppasm_pulista_base", type number}, {"xerppasm_subfamilia", type text}, {"xerppasm_tamano", Int64.Type}}),
				    #"Removed Other Columns" = Table.SelectColumns(#"Changed Type",{"xerppasm_color", "xerppasm_familia", "xerppasm_foto", "xerppasm_idproducto", "xerppasm_modelo", "xerppasm_nombreproducto", "xerppasm_nombreproveedor", "xerppasm_subfamilia"}),
