	column Formato
		lineageTag: 1f1d8bae-6632-43ff-b97f-35e04bb9fa0d
		isNameInferred
		sourceColumn: [Formato]
		sortByColumn: FormatoOrder

	column FormatoOrder
		isHidden
		lineageTag: ffddfb06-714d-4b6b-a2fe-511041ac1246
		isNameInferred
		sourceColumn: [FormatoOrder]

	partition param_Formato = calculated
