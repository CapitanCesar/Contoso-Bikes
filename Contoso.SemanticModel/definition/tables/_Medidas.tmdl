				        "€#,##0"
				    )

	/// Unidades vendidas sobre albaranes.
	measure 'Cantidad Vendida' = SUM( fact_Ventas[TCantidad] )
		displayFolder: Base
		lineageTag: 81f697b5-3810-42b6-8829-2e2225c7e858

		formatStringDefinition =
				VAR Seleccion = SELECTEDVALUE( param_Formato[FormatoOrder], 0 )
				RETURN
				    SWITCH(
				        Seleccion,
				        0, "#,##0",
				        1, "#,##0.0,K",
				        2, "#,##0.0,,M",
				        "#,##0"
				    )

	/// Número de albaranes con movimiento comercial.
	measure 'Nº Albaranes' = DISTINCTCOUNT( fact_Ventas[IdAlbaran] )
		formatString: #,##0
		displayFolder: Base
		lineageTag: 34e88963-d26b-443b-bce6-a5148e95f1b8

	/// Número de clientes con venta en el contexto filtrado.
	measure 'Nº Clientes' = DISTINCTCOUNT( fact_Ventas[IdCliente] )
		formatString: #,##0
		displayFolder: Base
		lineageTag: 7d6aea32-ff71-4fb0-b061-29294d233dd8

	/// Número de productos distintos vendidos.
	measure 'Nº Productos' = DISTINCTCOUNT( fact_Ventas[IdProducto] )
		formatString: #,##0
		displayFolder: Base
		lineageTag: bf24b6d4-9e6d-4e92-947d-c9bd5d302704

	/// Margen bruto generado por la venta servida.
	measure 'Margen Bruto' =
			VAR Ventas = [Ventas Netas]
			VAR Coste = [Coste Total]
			RETURN
			    Ventas - Coste
		displayFolder: Ratios y KPIs
		lineageTag: 6f7c9c14-81f7-46ab-85eb-2d3a9436a43d

		formatStringDefinition =
				VAR Seleccion = SELECTEDVALUE( param_Formato[FormatoOrder], 0 )
				RETURN
				    SWITCH(
				        Seleccion,
				        0, "€#,##0",
				        1, "€#,##0.0,K",
				        2, "€#,##0.0,,M",
				        "€#,##0"
				    )

	/// Porcentaje de margen bruto sobre ventas netas.
	measure 'Margen Bruto %' =
			VAR Margen = [Margen Bruto]
			VAR Ventas = [Ventas Netas]
			RETURN
			    DIVIDE( Margen, Ventas )
		formatString: 0.0%
		displayFolder: Ratios y KPIs
		lineageTag: 1b5dd139-3e13-4cc5-9827-7220cdac9fd5

	/// Venta neta media por albarán.
	measure 'Ticket Medio' =
			VAR Ventas = [Ventas Netas]
			VAR Albaranes = [Nº Albaranes]
			RETURN
			    DIVIDE( Ventas, Albaranes )
		displayFolder: Ratios y KPIs
		lineageTag: 15550c59-b3c9-461c-a525-b8ca9a1938e0

		formatStringDefinition =
