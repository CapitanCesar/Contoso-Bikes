				    )

	/// Ventas netas del mes anterior.
	measure 'Ventas Netas Mes Anterior' = CALCULATE( [Ventas Netas], DATEADD( dim_Fecha[Fecha], -1, MONTH ) )
		displayFolder: Time Intelligence\Período Anterior
		lineageTag: a313b891-f877-4c9d-8058-888f8675ea50

