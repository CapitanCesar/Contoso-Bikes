				        1, "€#,##0.0,K",
				        2, "€#,##0.0,,M",
				        "€#,##0"
				    )

	/// Variación porcentual de ventas netas frente al mismo periodo del año anterior.
	measure 'Ventas Netas Variación % vs AA' =
			VAR Actual = [Ventas Netas]
			VAR Anterior = [Ventas Netas Año Anterior]
			RETURN
			    DIVIDE( Actual - Anterior, Anterior )
		formatString: 0.0%
		displayFolder: Time Intelligence\Variación
		lineageTag: b8ce76f3-7a46-4102-bc52-4d15f98e890c

	/// Ventas netas acumuladas YTD del año anterior.
	measure 'Ventas Netas YTD Año Anterior' = CALCULATE( [Ventas Netas YTD], SAMEPERIODLASTYEAR( dim_Fecha[Fecha] ) )
		displayFolder: Time Intelligence\Acumulado Anterior
		lineageTag: 00270ea1-9673-4569-a345-a2fe7e37d39d

