				        2, "€#,##0.0,,M",
				        "€#,##0"
				    )

	/// Venta neta media por cliente en el contexto seleccionado.
	measure 'Venta Media por Cliente' =
			VAR Ventas = [Ventas Netas]
			VAR Clientes = [Nº Clientes]
			RETURN
			    DIVIDE( Ventas, Clientes )
		displayFolder: Ratios y KPIs
		lineageTag: 2272079d-d959-44cc-9fff-15bdbff42c89

		formatStringDefinition =
