	/// Ventas netas del mismo periodo del año anterior.
	measure 'Ventas Netas Año Anterior' = CALCULATE( [Ventas Netas], SAMEPERIODLASTYEAR( dim_Fecha[Fecha] ) )
		displayFolder: Time Intelligence\Período Anterior
		lineageTag: 2358bc85-65c9-48fc-8ce4-d5a1d03fac9c

		formatStringDefinition =
