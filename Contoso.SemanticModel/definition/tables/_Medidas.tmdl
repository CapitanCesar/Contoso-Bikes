/// Tabla contenedora de medidas explícitas del modelo.
table _Medidas
	lineageTag: 5879887f-6978-41c8-9e3f-3d4e95aa7f24

	/// Importe neto vendido según líneas de albarán.
	measure 'Ventas Netas' = SUM( fact_Ventas[TNeto] )
		displayFolder: Base
		lineageTag: c2ce739b-a2ee-4262-bbda-b3cd1e9c92e7

		formatStringDefinition =
				VAR Seleccion = SELECTEDVALUE( param_Formato[FormatoOrder], 0 )
				RETURN
				    SWITCH(
				        Seleccion,
				        0, "€#,##0",
				        1, "€#,##0.0,K",
				        2, "€#,##0.0,,M",
				        "€#,##0"
				    )

	/// Importe bruto antes de descuento según líneas de albarán.
	measure 'Ventas Brutas' = SUM( fact_Ventas[TBruto] )
		displayFolder: Base
		lineageTag: 2d99e569-2b51-4bff-96e7-f1848efcc1e0

		formatStringDefinition =
				VAR Seleccion = SELECTEDVALUE( param_Formato[FormatoOrder], 0 )
				RETURN
				    SWITCH(
				        Seleccion,
				        0, "€#,##0",
				        1, "€#,##0.0,K",
				        2, "€#,##0.0,,M",
				        "€#,##0"
				    )

	/// Coste total asociado a las ventas servidas.
	measure 'Coste Total' = SUM( fact_Ventas[TCoste] )
		displayFolder: Base
		lineageTag: dd08a44a-888f-47e1-b7be-c1852d170598

		formatStringDefinition =
				VAR Seleccion = SELECTEDVALUE( param_Formato[FormatoOrder], 0 )
				RETURN
				    SWITCH(
				        Seleccion,
				        0, "€#,##0",
				        1, "€#,##0.0,K",
				        2, "€#,##0.0,,M",
				        "€#,##0"
				    )

	/// Descuento total aplicado sobre las ventas.
	measure 'Descuento Total' = SUM( fact_Ventas[TDescuento] )
		displayFolder: Base
		lineageTag: 30005faa-2588-44a2-a3bb-e1ddf0a2fc1e

		formatStringDefinition =
				VAR Seleccion = SELECTEDVALUE( param_Formato[FormatoOrder], 0 )
				RETURN
