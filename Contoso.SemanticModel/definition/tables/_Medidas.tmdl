				        2, "€#,##0.0,,M",
				        "€#,##0.00"
				    )

	/// Porcentaje de descuento concedido sobre la venta bruta.
	measure 'Descuento %' =
			VAR Descuento = [Descuento Total]
			VAR Bruto = [Ventas Brutas]
			RETURN
			    DIVIDE( Descuento, Bruto )
		formatString: 0.0%
		displayFolder: Ratios y KPIs
		lineageTag: 8a01da26-0cbf-49db-8582-eaa912b426c7

	/// Ventas netas del canal online.
	measure 'Ventas Online' =
			CALCULATE(
			    [Ventas Netas],
			    'dim_Cliente'[Canal] = "Online"
