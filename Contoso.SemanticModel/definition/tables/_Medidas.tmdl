	/// Variación absoluta de ventas netas frente al mismo periodo del año anterior.
	measure 'Ventas Netas Variación vs AA' =
			VAR Actual = [Ventas Netas]
			VAR Anterior = [Ventas Netas Año Anterior]
			RETURN
			    Actual - Anterior
		displayFolder: Time Intelligence\Variación
		lineageTag: 6a87c3c6-53d5-43c7-afaf-52a306b9f108

		formatStringDefinition =
				VAR Seleccion = SELECTEDVALUE( param_Formato[FormatoOrder], 0 )
