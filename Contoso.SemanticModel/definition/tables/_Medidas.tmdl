	/// Variación porcentual entre el YTD actual y el YTD del año anterior.
	measure 'Ventas Netas Variación % YTD vs AA' =
			VAR Actual = [Ventas Netas YTD]
			VAR Anterior = [Ventas Netas YTD Año Anterior]
			RETURN
			    DIVIDE( Actual - Anterior, Anterior )
		formatString: 0.0%
		displayFolder: Time Intelligence\Acumulado Anterior
		lineageTag: 697bf1f9-72d0-47a3-bc9b-445ad7544fea

