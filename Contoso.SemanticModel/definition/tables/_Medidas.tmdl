	/// Precio neto medio por unidad vendida.
	measure 'Precio Medio' =
			VAR Ventas = [Ventas Netas]
			VAR Cantidad = [Cantidad Vendida]
			RETURN
			    DIVIDE( Ventas, Cantidad )
		displayFolder: Ratios y KPIs
		lineageTag: 8378738f-c8e7-4504-883e-b5a3e1c5c5f8

		formatStringDefinition =
				VAR Seleccion = SELECTEDVALUE( param_Formato[FormatoOrder], 0 )
				RETURN
				    SWITCH(
				        Seleccion,
				        0, "€#,##0.00",
				        1, "€#,##0.0,K",
				        2, "€#,##0.0,,M",
				        "€#,##0.00"
				    )

	/// Coste medio por unidad vendida.
	measure 'Coste Unitario Medio' =
			VAR Coste = [Coste Total]
			VAR Cantidad = [Cantidad Vendida]
			RETURN
			    DIVIDE( Coste, Cantidad )
		displayFolder: Ratios y KPIs
		lineageTag: fe1fecb0-83b7-4100-b26c-bcb86e6e7652

		formatStringDefinition =
