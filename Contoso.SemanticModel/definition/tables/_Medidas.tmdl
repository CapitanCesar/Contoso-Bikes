	/// Peso de las bicicletas sobre la venta neta total.
	measure '% Ventas Bicicletas' =
			VAR VentasBicicletas = [Ventas Bicicletas]
			VAR VentasTotales = [Ventas Netas]
			RETURN
			    DIVIDE( VentasBicicletas, VentasTotales )
		formatString: 0.0%
		displayFolder: Segmentación
		lineageTag: d5e5fc61-afac-41af-992b-430b2ae99d00

